{
  "name": "@dockhive/push-react-native",
  "version": "0.1.0",
  "description": "Hive Push for React Native: native iOS (APNs) and Android (FCM) push notifications, user targeting, tags, open tracking and a live in-app inbox.",
  "license": "MIT",
  "author": "DockHive",
  "homepage": "https://docs.dockhive.io/push/",
  "keywords": ["push", "push-notifications", "notifications", "inbox", "react-native", "apns", "fcm", "dockhive"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": ["lib", "src", "!**/__tests__", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "@react-native-firebase/app": ">=18.0.0",
    "@react-native-firebase/messaging": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.3"
  }
}
